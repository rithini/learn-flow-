ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="LearnFlow API"

# Database
# For SQLite local development: sqlite:///./learnflow.db
# For PostgreSQL: postgresql://learnflow:learnflow_secret_pass@localhost:5432/learnflow_db
DATABASE_URL=sqlite:///./learnflow.db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Security / JWT
JWT_SECRET_KEY=learnflow_development_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# AI Providers
AI_PROVIDER=mock # Options: mock, gemini, openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["pdf","pptx","docx","txt"]
